# Binance API Management → Create API key
# Enable Reading only. Do not enable Spot/Futures trading or Withdrawals.
# Restrict the key to this host's public IP.
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Production: https://api.binance.com
# US:         https://api.binance.us
# Testnet:    https://testnet.binance.vision  (spot only; wallet SAPI may be unavailable)
BINANCE_BASE_URL=https://api.binance.com
BINANCE_RECV_WINDOW=10000

# Comma-separated: deposit,withdraw,transfer,trade,order
# trade/order require BINANCE_SYMBOLS
BINANCE_SOURCES=deposit,withdraw,transfer
# BINANCE_SYMBOLS=BTCUSDT,ETHUSDT

# Wallet transfer types to poll. Leave unset for the built-in common list.
# BINANCE_TRANSFER_TYPES=MAIN_UMFUTURE,UMFUTURE_MAIN,MAIN_FUNDING,FUNDING_MAIN

# Coralogix Logs API
# Coralogix → Data Flow → API Keys → Send-Your-Data
CORALOGIX_SEND_YOUR_DATA_KEY=your_coralogix_send_your_data_key
# Domain examples: eu1.coralogix.com, eu2.coralogix.com, coralogix.in, cx498.coralogix.com
CORALOGIX_DOMAIN=eu1.coralogix.com
CORALOGIX_APPLICATION_NAME=binance
CORALOGIX_SUBSYSTEM_NAME=exchange-logs

# Poll last 5 minutes, every 5 minutes
POLL_INTERVAL_SECONDS=300
LOOKBACK_MINUTES=5
STATE_FILE=./state.json
CORALOGIX_BATCH_SIZE=200
HTTP_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
